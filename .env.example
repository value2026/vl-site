# ============================================================
# Virtual Labs — Production Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ── JWT Secret (CHANGE THIS — use a long random string) ──────
JWT_SECRET=change-this-to-a-very-long-random-secret-string

# ── Frontend URL (your domain or server IP) ──────────────────
# Examples:
#   http://192.168.1.100       (LAN/local server IP)
#   https://vlab.amrita.edu/v2
FRONTEND_URL=https://vlab.amrita.edu/v2
CORS_ORIGINS=

# Frontend build-time URLs. The institutional proxy strips /v2 before
# forwarding to Docker Nginx, but browsers must request the public /v2 paths.
VITE_API_URL=/v2/api
VITE_FILES_URL=/v2/files
VITE_SOCKET_PATH=/v2/socket.io

# ── SMTP Mailer Settings (e.g. Gmail / Mailgun) ─────────────
# Set these to send actual automated credential emails to registered users
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Virtual Labs Admin" <your-email@gmail.com>


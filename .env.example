# ============================================================
# Virtual Labs — Production Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ── PostgreSQL Database ──────────────────────────────────────
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name

# ── JWT Secret (CHANGE THIS — use a long random string) ──────
JWT_SECRET=change-this-to-a-very-long-random-secret-string

# ── Frontend URL (your domain or server IP) ──────────────────
FRONTEND_URL=https://vlab.amrita.edu/v2
CORS_ORIGINS=

# ── Frontend build-time URLs ─────────────────────────────────
VITE_API_URL=/v2/api
VITE_FILES_URL=/v2/files
VITE_SOCKET_PATH=/v2/socket.io
VITE_GA_MEASUREMENT_ID=your_ga_id

# ── SMTP Mailer Settings (e.g. Gmail / Mailgun) ──────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Virtual Labs Admin <your-email@gmail.com>"

# ── Google Analytics 4 API Credentials (Backend) ─────────────
GA_PROPERTY_ID=your_ga_property_id
GA_CLIENT_EMAIL=your_ga_client_email
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

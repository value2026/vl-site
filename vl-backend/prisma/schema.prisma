// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  nodal_centre
  teacher
  student
  content_admin
  sim_admin
  vl_manager
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  role     Role
  isActive          Boolean  @default(true)
  customPermissions String[] @default([])

  // Additional fields requested by user
  username          String? @unique
  mobile            String?
  profilePic        String?
  org               String?
  dept              String?
  course            String?
  yearSemester      String?
  country           String?
  state             String?
  city              String?
  studentId         String?
  batch             String?
  section           String?
  employeeId        String?
  designation       String?
  facultyDept       String?
  facultyInst       String?
  
  // Password reset fields
  resetToken        String?
  resetTokenExpiry  DateTime?

  // Hierarchy: who created this user
  createdById  String?
  createdBy    User?   @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("CreatedBy")

  // Which nodal centre (Institution) this user belongs to
  nodalCentreId String?
  nodalCentre   Institution? @relation("InstitutionMembers", fields: [nodalCentreId], references: [id], onDelete: SetNull)

  // Lab management relations
  subjectsCreated    Subject[]    @relation("SubjectCreator")
  labsCreated        Lab[]        @relation("LabCreator")
  experimentsCreated Experiment[] @relation("ExperimentCreator")
  
  institutionsCreated Institution[] @relation("InstitutionCreator")
  workshopsCreated    Workshop[]    @relation("WorkshopCreator")

  // Analytics relations
  quizAttempts       QuizAttempt[]
  experimentVisits   ExperimentVisit[]
  feedbacks          Feedback[]

  // Communication relations
  chatSent           ChatMessage[]          @relation("SentMessages")
  chatReceived       ChatMessage[]          @relation("ReceivedMessages")
  hostedCalls        ScheduledCall[]        @relation("HostedCalls")
  inviteeRecords     ScheduledCallInvitee[] @relation("InviteeRecords")

  // Assignment & Notification relations
  questionPapersCreated QuestionPaper[]     @relation("QuestionPaperCreator")
  assignmentsCreated    Assignment[]        @relation("TeacherAssignments")
  assignmentsAssigned   AssignmentStudent[] @relation("StudentAssignments")
  assignmentAttempts    AssignmentAttempt[] @relation("StudentAssignmentAttempts")
  notifications         Notification[]      @relation("UserNotifications")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Subject {
  id          String  @id @default(uuid())
  title       String
  icon        String  @default("📚")
  description String?
  gradient    String  @default("from-blue-600 to-indigo-700")
  isActive    Boolean @default(true)

  createdById String
  createdBy   User   @relation("SubjectCreator", fields: [createdById], references: [id])

  labs Lab[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subjects")
}

model Lab {
  id          String  @id @default(uuid())
  title       String
  description String?
  icon        String  @default("🔬")
  coverPic    String? // URL to lab cover image
  isActive    Boolean @default(true)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  createdById String
  createdBy   User   @relation("LabCreator", fields: [createdById], references: [id])

  // Which nodal centre (Institution) owns this lab (null = admin-created global lab)
  nodalCentreId String?
  nodalCentre   Institution? @relation("LabNodalCentre", fields: [nodalCentreId], references: [id])

  experiments Experiment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("labs")
}

model Experiment {
  id          String  @id @default(uuid())
  title       String
  description String?
  duration    String  @default("60 min")
  difficulty  String  @default("Beginner")
  coverPic    String? // URL to experiment cover image
  isActive    Boolean @default(true)

  // Paths to extracted zip content (relative to uploads/)
  contentPath    String? // e.g. experiments/{id}/content
  simulationPath String? // e.g. experiments/{id}/simulation

  labId String
  lab   Lab    @relation(fields: [labId], references: [id])

  createdById String
  createdBy   User   @relation("ExperimentCreator", fields: [createdById], references: [id])

  // Analytics relations
  quizAttempts     QuizAttempt[]
  experimentVisits ExperimentVisit[]
  feedbacks        Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("experiments")
}

model QuizAttempt {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  quizType     String     // "pretest" or "posttest"
  score        Int
  maxScore     Int
  passed       Boolean
  createdAt    DateTime   @default(now())

  @@map("quiz_attempts")
}

model ExperimentVisit {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  duration     Int        @default(0) // seconds spent
  device       String?    // mobile, tablet, desktop
  browser      String?    // chrome, firefox, safari
  createdAt    DateTime   @default(now())

  @@map("experiment_visits")
}

model Feedback {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  rating       Int        // 1 to 5 stars
  comment      String?
  createdAt    DateTime   @default(now())

  @@map("feedbacks")
}

model ChatMessage {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())

  @@map("chat_messages")
}

model ScheduledCall {
  id          String   @id @default(uuid())
  title       String
  description String?
  scheduledAt DateTime
  duration    Int      // Duration in minutes (e.g. 30, 60)
  hostId      String
  host        User     @relation("HostedCalls", fields: [hostId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  invitees ScheduledCallInvitee[]

  @@map("scheduled_calls")
}

model ScheduledCallInvitee {
  id              String        @id @default(uuid())
  scheduledCallId String
  scheduledCall   ScheduledCall @relation(fields: [scheduledCallId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation("InviteeRecords", fields: [userId], references: [id], onDelete: Cascade)
  status          String        @default("pending") // pending, accepted, declined
  createdAt       DateTime      @default(now())

  @@unique([scheduledCallId, userId])
  @@map("scheduled_call_invitees")
}

// ── CMS: Page Content Management ─────────────────────────────

model Page {
  id        String        @id @default(uuid())
  slug      String        @unique // e.g. "home", "project", "workshop"
  title     String
  sections  PageSection[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("pages")
}

model PageSection {
  id         String   @id @default(uuid())
  pageId     String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sectionKey String   // e.g. "hero", "news", "sponsors", "cta"
  label      String   // Human-readable name shown in admin UI
  title      String?
  subtitle   String?
  content    Json     @default("{}") // Flexible blob for section-specific data
  isVisible  Boolean  @default(true)
  order      Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([pageId, sectionKey])
  @@map("page_sections")
}

model Institution {
  id           String   @id @default(uuid())
  legacyId     Int?     @unique
  name         String   @unique
  code         String?
  oldCreatedAt String?
  isActive     Boolean  @default(true)
  
  users        User[]   @relation("InstitutionMembers")
  labs         Lab[]    @relation("LabNodalCentre")

  createdById  String?
  createdBy    User?    @relation("InstitutionCreator", fields: [createdById], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("institutions")
}

model Workshop {
  id          String   @id @default(uuid())
  title       String
  description String?
  date        DateTime
  location    String?
  mode        String?  @default("Online") // Online, Hybrid, In-person
  seats       Int?
  status      String   @default("pending") // pending, approved, rejected
  
  createdById String
  createdBy   User     @relation("WorkshopCreator", fields: [createdById], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("workshops")
}

model SurveyResponse {
  id        String   @id @default(uuid())
  pageSlug  String   // Which survey this belongs to (e.g., student-survey, faculty-survey)
  data      Json     // The actual answers submitted
  createdAt DateTime @default(now())

  @@map("survey_responses")
}

model QuestionPaper {
  id          String       @id @default(uuid())
  title       String
  questions   Json         // Array of MCQ questions: { questionText: string, options: string[], correctOptionIndex: number }[]
  createdById String
  createdBy   User         @relation("QuestionPaperCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignments Assignment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("question_papers")
}

model Assignment {
  id               String              @id @default(uuid())
  title            String              // Custom label for this scheduled assignment
  startTime        DateTime
  endTime          DateTime
  maxAttempts      Int                 @default(1)
  resultDisplay    String              @default("immediate") // "immediate" or "manual"
  resultsPublished Boolean             @default(false)
  isActive         Boolean             @default(true)
  
  questionPaperId  String
  questionPaper    QuestionPaper       @relation(fields: [questionPaperId], references: [id], onDelete: Cascade)
  
  teacherId        String
  teacher          User                @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  
  students         AssignmentStudent[]
  attempts         AssignmentAttempt[]
  
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@map("assignments")
}

model AssignmentStudent {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([assignmentId, studentId])
  @@map("assignment_students")
}

model AssignmentAttempt {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation("StudentAssignmentAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  score        Int
  maxScore     Int
  answers      Json       // Student's selected option indices: { [questionIndex]: number }
  completedAt  DateTime   @default(now())

  @@map("assignment_attempts")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("info") // "exam_reminder", "info"
  createdAt DateTime @default(now())

  @@map("notifications")
}


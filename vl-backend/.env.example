# ============================================================
# Virtual Labs Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values

# --- PostgreSQL Database ---
# Local PostgreSQL (replace YOUR_PASSWORD with your postgres password):
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/virtuallabs_db"

# OR if using Neon.tech (free cloud Postgres):
# DATABASE_URL="postgresql://username:password@ep-xxxx.us-east-2.aws.neon.tech/virtuallabs_db?sslmode=require"

# --- JWT Secret (keep this secret, change it!) ---
JWT_SECRET="vl-super-secret-jwt-key-change-in-production-2024"

# --- Server Port ---
PORT=5000

# --- Frontend URL (for CORS and generated email links) ---
FRONTEND_URL="https://vlab.amrita.edu/v2"
CORS_ORIGINS=""

# ============================================================
# Virtual Labs Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values

# --- PostgreSQL Database ---
# Local PostgreSQL (replace YOUR_PASSWORD with your postgres password):
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/virtuallabs_db"

# OR if using Neon.tech (free cloud Postgres):
# DATABASE_URL="postgresql://username:password@ep-xxxx.us-east-2.aws.neon.tech/virtuallabs_db?sslmode=require"

# --- JWT Secrets (keep these secret, change in production!) ---
JWT_SECRET="vl-super-secret-jwt-key-change-in-production-2024"
JWT_REFRESH_SECRET=""

# --- Server Port ---
PORT=5000

# --- Frontend URL & CORS (for CORS and generated email links) ---
# Local Vite development. For Docker Compose, set this to http://localhost.
# Production v2 deployment: https://vlab.amrita.edu/v2
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS=""

# --- Google OAuth (Guest Sign-In) ---
GOOGLE_CLIENT_ID=""

# --- SMTP Mailer Settings (Configure to send actual emails) ---
# For Gmail, use SMTP_HOST="smtp.gmail.com", port 587, and an App Password for SMTP_PASS
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM='"Virtual Labs Admin" <your-email@gmail.com>'

# --- Google Analytics 4 API Credentials (Optional) ---
GA_PROPERTY_ID=""
GA_CLIENT_EMAIL=""
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
